# ==============================================================================
# Disaster Intelligence Pipeline - Phase 1 Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (do NOT commit .env to source control):
#    cp .env.example .env
# 2. Replace the placeholder below with your real Tavily API key.
#    Get an API key at https://app.tavily.com
# ==============================================================================

# Required: Tavily API Key
TAVILY_API_KEY=tvly-your-api-key-here

# Optional defaults
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5
TAVILY_TOPIC=news

# ==============================================================================
# ReliefWeb Humanitarian API Configuration (UN OCHA)
# ==============================================================================
# ReliefWeb v2 requires a pre-approved appname in the URL request.
# Request an appname at: https://apidoc.reliefweb.int/parameters#appname
# RELIEFWEB_APPNAME=your-approved-appname-here
# RELIEFWEB_TIMEOUT=30
# RELIEFWEB_LIMIT=10

# ==============================================================================
# NASA FIRMS API Configuration (Active Fire & Thermal Anomalies)
# ==============================================================================
# NASA FIRMS provides near-real-time and archive active fire detections (MODIS/VIIRS).
# A free personal 32-character MAP_KEY is required to query the REST API.
# Request a free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=your-nasa-firms-map-key-here
# FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
# FIRMS_SOURCE=VIIRS_SNPP_NRT
# FIRMS_TIMEOUT=30

