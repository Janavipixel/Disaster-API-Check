# ==============================================================================
# RakhshakRapid Platform Environment Configuration Template
# Copy this file to '.env' inside 'Disaster API/' (or set system env vars).
# DO NOT commit real API keys or credentials to version control.
# ==============================================================================

# 1. Tavily AI Search (Disaster claim extraction & cross-verification)
# Obtain key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# 2. NASA FIRMS (Active thermal anomaly detection for wildfires)
# Obtain map key at: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=your_firms_map_key_here

# 3. UN OCHA ReliefWeb API v2 (Humanitarian situation reports)
# Register appname at: https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=your_reliefweb_appname_here

# 4. Copernicus Data Space Ecosystem (CDSE) Sentinel-1 SAR Credentials
# Register OAuth2 client at: https://dataspace.copernicus.eu
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here
