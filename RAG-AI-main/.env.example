# Disaster Intelligence RAG Module — Environment Variables
# Copy this file to .env and fill in the values you have.
# The system works without any API keys (offline fixtures are used).

# ── LLM for RAG Answer Generation (at least one recommended) ──────────────────
# Option A: Google Gemini (free tier available)
GOOGLE_API_KEY=your_gemini_api_key_here

# Option B: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# ── Optional Enrichment ───────────────────────────────────────────────────────
# Tavily Search API (optional — enables richer web search extraction)
TAVILY_API_KEY=your_tavily_api_key_here

# ── Embedding Model (defaults shown — no key needed for local models) ─────────
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cpu

# ── Vector DB ─────────────────────────────────────────────────────────────────
# CHROMA_PERSIST_DIR=./data/chroma_db

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
